  "topics": [
    {
      "code": "4.1",
      "n": 1,
      "name": "Setting a Goal",
      "summary": "Talk about setting a goal and what it looks like at the pool.",
      "prompts": [
        "Who can you ask for help at the pool?",
        "Why do we walk instead of run on the deck?"
      ],
      "notes": []
    },
    {
      "code": "4.2",
      "n": 2,
      "name": "Open Water",
      "summary": "Share one idea about open water and try it during the lesson.",
      "prompts": [
        "What does a good listener do?",
        "How can you help a friend who feels nervous?"
      ],
      "notes": [
        "Keep it short and let swimmers do the talking."
      ]
    },
    {
      "code": "4.3",
      "n": 3,
      "name": "Swimming with a Buddy",
      "summary": "Swimmers name one way to practise swimming with a buddy today.",
      "prompts": [
        "What makes you feel safe in the water?",
        "What did you do well today?"
      ],
      "notes": []
    },
    {
      "code": "4.4",
      "n": 4,
      "name": "Good Sportsmanship",
      "summary": "Talk about good sportsmanship and what it looks like at the pool.",
      "prompts": [
        "What would you like to practise next time?",
        "Where is a safe place to wait for your turn?"
      ],
      "notes": []
    },
    {
      "code": "4.5",
      "n": 5,
      "name": "Healthy Habits",
      "summary": "Share one idea about healthy habits and try it during the lesson.",
      "prompts": [
        "What can you do if you get tired in the water?",
        "How do you know when it is your turn?",
        "What is your favourite pool game, and why?"
      ],
      "notes": []
    },
    {
      "code": "4.6",
      "n": 6,
      "name": "Helping from the Deck",
      "summary": "Swimmers name one way to practise helping from the deck today.",
      "prompts": [
        "Who watches you when you are near water?",
        "What should you do before getting in?"
      ],
      "notes": []
    },
    {
      "code": "4.7",
      "n": 7,
      "name": "Keeping Calm",
      "summary": "Talk about keeping calm and what it looks like at the pool.",
      "prompts": [
        "How does your body feel after swimming?",
        "What is one kind thing you saw today?"
      ],
      "notes": []
    },
    {
      "code": "4.8",
      "n": 8,
      "name": "Looking Back",
      "summary": "Share one idea about looking back and try it during the lesson.",
      "prompts": [
        "What would you tell a new swimmer?",
        "When is it OK to go in the water?"
      ],
      "notes": [
        "Keep it short and let swimmers do the talking."
      ]
    }
  ],
